# Diagnostic functions for DND area

# version
$DND_version = "1.0.230620.0"

# Area and Area/Component arrays
$DND = @("xray_dnd_pnp")

#Component/Diagnostic Function arrays
$xray_dnd_pnp = @("dnd_pnp_KB5017275")

# begin: diagnostic functions

#region dnd_pnp_KB5017275
<# 
Component: PnP
Checks for:
 PnPCapabilities registry value when present will cause issues on CS/MS devices
Created by: tdimli
#>
function dnd_pnp_KB5017275
{
    param(
        [Parameter(Mandatory=$true,
        Position=0)]
        [Boolean]
        $offline
    )
$issueMsg = @"
"PnPCapabilities" value is present in following registry location(s): 
 {0}

This device supports "Standby (S0 Low Power Idle)" state and above registry 
value does not apply and may cause issues on Connected Standby/Modern Standby 
(CS/MS) capable devices.

"PnPCapabilities" value serves no purpose on CS/MS capable devices and should be 
removed to avoid issues. The UI to control this registry value is not present 
on CS/MS capable devices and as such, the value needs to be manually removed.
"@

    if($offline) {
        LogWrite "Cannot run offline, skipping"
        return $RETURNCODE_SKIPPED
    }

    # Look for the issue
    try
    {
        $issueFound = $false
        $listAdapters = ""
        $powercfg = "powercfg.exe"
        $myExeOutput = & $powercfg /a

        $hasS0 = $false
        foreach ($line in $myExeOutput) {
            if ($line -eq '') {
                # end of available sleep states
                break
            }
            if ($line.Contains('S0')) {
                $hasS0 = $true
            }
        }

        if ($hasS0) {
            LogWrite "S0 available"
            # check registry
            $regKey = (Get-ChildItem -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Class\{4D36E972-E325-11CE-BFC1-08002bE10318}' -ErrorAction Ignore)
            if ($regKey -ne $null) {
                foreach ($regSubKey in $regKey) {
                    $PnPCapabilities = Get-ItemProperty -Path "Registry::$($regSubKey.Name)" -Name 'PnPCapabilities' -ErrorAction Ignore
                    if ($PnPCapabilities -ne $null) {
                        $issueFound = $true
                        $listAdapters += "`r`n$($regSubKey.Name)"
                    }
                }
                if ($issueFound) {
                    # issue present
                    $issueMsg = [string]::Format($issueMsg, $listAdapters)
                    ReportIssue $issueMsg $ISSUETYPE_ERROR
                }
            }
        }
        else {
            LogWrite "S0 not available"
        }
    }
	catch {
		LogWrite "Failed - exiting! (Error: $_)"
        return $RETURNCODE_FAILED
    }

    return $RETURNCODE_SUCCESS
}
#endregion dnd_pnp_KB5017275

# end: diagnostic functions

